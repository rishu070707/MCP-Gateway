# ==============================================================================
# URUMI AI — TEAM MCP GATEWAY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Gateway Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_SECRET_KEY=change-me-in-production-super-secret-jwt-key-32chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Database Configuration (PostgreSQL in Production, SQLite fallback for unit tests)
DATABASE_URL=postgresql://urumi_user:urumi_password@localhost:5432/urumi_gateway
# Local fallback test SQLite URL:
# DATABASE_URL=sqlite:///./gateway.db

# Initial Admin Seed
ADMIN_EMAIL=admin@urumi.local
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=AdminSecurePass123!

# LLM / AI Configuration (OpenAI Compatible)
# Compatible with OpenAI, Ollama, vLLM, Groq, Anthropic-proxy, or Local Mock
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-or-compatible-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# When set to true, Gateway will use deterministic AI simulation if no LLM_API_KEY is provided
AI_SIMULATION_FALLBACK=true

# Upstream MCP Network & Timeout Defaults
MCP_CONNECT_TIMEOUT_SECONDS=3.0
MCP_REQUEST_TIMEOUT_SECONDS=15.0
MCP_MAX_RETRIES=2

# SSRF Protection
# Comma-separated list of allowed internal hosts/domains in Kubernetes (e.g. woo-mcp,inventory-mcp,analytics-mcp)
SSRF_ALLOWED_INTERNAL_HOSTS=woo-mcp,inventory-mcp,analytics-mcp,localhost,127.0.0.1
SSRF_STRICT_MODE=false

# WooCommerce Store Settings (for Woo MCP service)
WOOCOMMERCE_URL=http://wordpress:80
WOOCOMMERCE_CONSUMER_KEY=ck_urumi_demo_consumer_key_12345
WOOCOMMERCE_CONSUMER_SECRET=cs_urumi_demo_consumer_secret_67890
WOOCOMMERCE_MOCK_FALLBACK=true

# Upstream MCP Service Endpoints (used by Gateway discovery / auto-seeding)
WOO_MCP_URL=http://woo-mcp:8001/mcp
INVENTORY_MCP_URL=http://inventory-mcp:8002/mcp
ANALYTICS_MCP_URL=http://analytics-mcp:8003/mcp

# Dashboard Frontend
VITE_GATEWAY_API_URL=http://localhost:8000
